# Mi Sagrado Corazón — variables de entorno
# Plantilla sin valores reales. No subir nunca un .env con valores al repositorio.
#
# Dónde se leen:
#   - API (apps/api):  apps/api/.env    -> sección API
#   - App (Expo):      apps/mobile/.env -> sección FRONTEND

# ---------------------------------------------------------------------------
# API NUEVA (apps/api) -> copiar a apps/api/.env
# ---------------------------------------------------------------------------

# PostgreSQL. Ej. local: postgresql://postgres@localhost:5432/msc_dev
DATABASE_URL=

# Puerto HTTP de la API (por defecto 8001).
PORT=

# Secreto de sesiones de Better Auth. Mínimo 32 caracteres, distinto por entorno.
# Generar con: openssl rand -base64 32
BETTER_AUTH_SECRET=

# URL pública de la API (ej. http://localhost:8001 o https://api.misagradocorazon.com).
BETTER_AUTH_URL=

# Orígenes web permitidos (panel y web de la app), separados por comas.
TRUSTED_ORIGINS=

# Clave AES-256 para cifrar las intenciones de oración (GDPR art. 9). 32 bytes en base64.
# Generar con: openssl rand -base64 32. Si se pierde, las intenciones cifradas son irrecuperables.
INTENTIONS_KEY=

# Login con Google y Apple (opcionales en desarrollo). Cuentas a nombre del fundador.
# Pasos para obtenerlas: docs/login-social.md
# Google: ID de cliente OAuth de tipo "web" (el mismo que EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID).
GOOGLE_CLIENT_ID=
# Opcional: el login nativo no lo usa.
GOOGLE_CLIENT_SECRET=
# Apple (solo iOS, nativo): bundle ID de la app.
APPLE_BUNDLE_ID=com.misagradocorazon.app

# Solo para el alta de staff sin terminal interactiva (pnpm --filter @msc/api staff:create).
# No dejarla fijada en el entorno: se pasa en la misma orden y se descarta.
STAFF_PASSWORD=

# Tests de la API: base PostgreSQL cuyo nombre termine en _test.
TEST_DATABASE_URL=

# ---------------------------------------------------------------------------
# FRONTEND (Expo)
# ---------------------------------------------------------------------------

# URL de la API nueva (apps/api), sin /api al final. Ej. local: http://localhost:8001 (apps/mobile/src/api.ts).
# El chat de misa usa la misma URL (Socket.IO).
EXPO_PUBLIC_BACKEND_URL=

# Login con Google en la app (iOS y Android). Sin ellas, el botón de Google no aparece.
# Cliente "web" (el mismo que GOOGLE_CLIENT_ID de la API) y cliente "iOS".
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Opcional. Directorio de caché de Metro (apps/mobile/metro.config.js).
# Por defecto: apps/mobile/.metro-cache
METRO_CACHE_ROOT=
