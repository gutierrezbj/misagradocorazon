# Mi Sagrado Corazón — variables de entorno
# Plantilla sin valores reales. No subir nunca un .env con valores al repositorio.
#
# Dónde se leen hoy (código entregado por el constructor):
#   - Backend (FastAPI): backend/.env  -> copiar las variables de la sección BACKEND
#   - App (Expo):        apps/mobile/.env -> copiar las variables de la sección FRONTEND
#   - Tests backend:     backend/.env  -> usan EXPO_PUBLIC_BACKEND_URL y las SEED_*

# ---------------------------------------------------------------------------
# API NUEVA (apps/api) -> copiar a apps/api/.env
# ---------------------------------------------------------------------------

# PostgreSQL. Ej. local: postgresql://postgres@localhost:5432/msc_dev
DATABASE_URL=

# Puerto HTTP de la API (por defecto 8001).
PORT=

# Secreto de sesiones de Better Auth. Mínimo 32 caracteres, distinto por entorno.
# Generar con: openssl rand -base64 32
BETTER_AUTH_SECRET=

# URL pública de la API (ej. http://localhost:8001 o https://api.misagradocorazon.com).
BETTER_AUTH_URL=

# Orígenes web permitidos (panel y web de la app), separados por comas.
TRUSTED_ORIGINS=

# Clave AES-256 para cifrar las intenciones de oración (GDPR art. 9). 32 bytes en base64.
# Generar con: openssl rand -base64 32. Si se pierde, las intenciones cifradas son irrecuperables.
INTENTIONS_KEY=

# Login con Google y Apple (opcionales en desarrollo). Cuentas a nombre del fundador.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Tests de la API: base PostgreSQL cuyo nombre termine en _test.
TEST_DATABASE_URL=

# ---------------------------------------------------------------------------
# BACKEND PROVISIONAL (backend/, FastAPI + MongoDB, congelado)
# ---------------------------------------------------------------------------

# Cadena de conexión a MongoDB. Obligatoria (backend/server.py).
MONGO_URL=

# Nombre de la base de datos. Obligatoria (backend/server.py).
DB_NAME=

# Cuentas de staff creadas por el seed al arrancar (backend/seed.py).
# Cada cuenta solo se crea si se definen su email Y su contraseña.
# Si la cuenta ya existe, el seed sobrescribe su contraseña y su rol.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_EDITOR_EMAIL=
SEED_EDITOR_PASSWORD=
SEED_MODERATOR_EMAIL=
SEED_MODERATOR_PASSWORD=

# ---------------------------------------------------------------------------
# FRONTEND (Expo)
# ---------------------------------------------------------------------------

# URL base del backend, sin /api al final (apps/mobile/src/api.ts).
# Los tests del backend también la usan como servidor contra el que lanzar las pruebas.
EXPO_PUBLIC_BACKEND_URL=

# Opcional. Directorio de caché de Metro (apps/mobile/metro.config.js).
# Por defecto: apps/mobile/.metro-cache
METRO_CACHE_ROOT=
