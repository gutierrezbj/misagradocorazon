// Modelo de datos de Mi Sagrado Corazón (SDD-03, 26-sep-2026).
// Bloque 1: autenticación (Better Auth), perfil, santos, contenido diario, oraciones, velas, libro.
// Bloque 2: muro de intenciones y moderación, misa y chat, causas, votos y auditoría.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  user
  moderator
  editor
  superadmin
}

enum Locale {
  es
  en
}

enum CandleType {
  basic
  solemn
  permanent
}

enum CandleCategory {
  general
  difuntos
}

enum PrayerKind {
  morning
  night
}

enum IntentionCategory {
  salud
  familia
  trabajo
  difuntos
  agradecimiento
  general
}

enum ModerationStatus {
  pending
  approved
  hidden
}

enum CauseStatus {
  candidate
  voting
  won
  funded
  archived
}

enum LedgerEntryType {
  purchase
  impact_allocation
  transfer
}

// ---------------------------------------------------------------------------
// Autenticación (Better Auth). Nombres de campos fijados por la librería.
// ---------------------------------------------------------------------------

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  role    Role    @default(user)
  blocked Boolean @default(false)

  // Perfil devocional (onboarding)
  onboarded         Boolean  @default(false)
  patronSaintId     String?
  secondarySaintIds String[] @default([])
  language          Locale   @default(es)
  timezone          String   @default("America/Mexico_City")
  morningTime       String   @default("07:30")
  angelusTime       String   @default("12:00")
  nightTime         String   @default("21:30")

  patronSaint Saint?      @relation("PatronSaint", fields: [patronSaintId], references: [id])
  sessions    Session[]
  accounts    Account[]
  candles           Candle[]
  prayerLogs        PrayerLog[]
  intentions        Intention[]
  intentionPrayers  IntentionPrayer[]
  privateIntentions PrivateIntention[]
  chatMessages      ChatMessage[]
  votes             Vote[]
  auditLogs         AdminAuditLog[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// Ritual diario
// ---------------------------------------------------------------------------

model Saint {
  id              String   @id
  name            String
  feastDate       String   // MM-DD
  imageUrl        String
  audioUrlEs      String?
  audioUrlEn      String?
  historyEs       String
  historyEn       String
  patronagesEs    String
  patronagesEn    String
  prayerEs        String
  prayerEn        String
  isPatronCatalog Boolean  @default(false)
  sortOrder       Int      @default(100)
  deletedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  patronOf   User[]         @relation("PatronSaint")
  candles    Candle[]
  dailyItems DailyContent[]

  @@map("saint")
}

model DailyContent {
  date              String  @id // YYYY-MM-DD
  saintOfDayId      String?
  gospelRef         String
  gospelEs          String
  gospelEn          String
  meditationEs      String
  meditationEn      String
  meditationAudioUrl String?
  morningPrayerEs   String
  morningPrayerEn   String
  nightPrayerEs     String
  nightPrayerEn     String
  morningAudioUrl   String?
  nightAudioUrl     String?
  updatedAt         DateTime @updatedAt

  saintOfDay Saint? @relation(fields: [saintOfDayId], references: [id])

  @@map("daily_content")
}

model PrayerLog {
  id        String     @id @default(uuid())
  userId    String
  localDate String     // YYYY-MM-DD en la zona horaria del usuario
  kind      PrayerKind
  createdAt DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, localDate, kind])
  @@index([userId, localDate])
  @@map("prayer_log")
}

// ---------------------------------------------------------------------------
// Vela y dinero
// ---------------------------------------------------------------------------

model Candle {
  id                 String         @id @default(uuid())
  userId             String
  saintId            String
  intentionEncrypted String         // AES-256-GCM (GDPR art. 9)
  type               CandleType
  category           CandleCategory @default(general)
  priceCents         Int
  paymentProvider    String
  paymentRef         String         @unique
  litAt              DateTime       @default(now())
  expiresAt          DateTime

  user   User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  saint  Saint         @relation(fields: [saintId], references: [id])
  ledger LedgerEntry[]

  @@index([userId, litAt])
  @@index([expiresAt])
  @@map("candle")
}

// Libro de movimientos de solo inserción (ADR-015). Nunca se actualiza ni se borra.
model LedgerEntry {
  id          String          @id @default(uuid())
  type        LedgerEntryType
  amountCents Int
  month       String          // YYYY-MM
  candleId    String?
  causeId     String?
  note        String?
  createdAt   DateTime        @default(now())

  candle Candle? @relation(fields: [candleId], references: [id])
  cause  Cause?  @relation(fields: [causeId], references: [id])

  @@index([month, type])
  @@map("ledger_entry")
}

// ---------------------------------------------------------------------------
// Muro de intenciones y moderación
// ---------------------------------------------------------------------------

model Intention {
  id        String            @id @default(uuid())
  userId    String
  text      String            // Pública por decisión del autor; no se cifra.
  category  IntentionCategory @default(general)
  status    ModerationStatus
  createdAt DateTime          @default(now())

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  prayers IntentionPrayer[]

  @@index([status, createdAt])
  @@map("intention")
}

model IntentionPrayer {
  intentionId String
  userId      String
  createdAt   DateTime @default(now())

  intention Intention @relation(fields: [intentionId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([intentionId, userId])
  @@map("intention_prayer")
}

// "Por quién rezo hoy": privadas y cifradas (GDPR art. 9).
model PrivateIntention {
  id            String   @id @default(uuid())
  userId        String
  textEncrypted String
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("private_intention")
}

model ModerationWord {
  word      String   @id // normalizada: minúsculas y sin tildes
  createdAt DateTime @default(now())

  @@map("moderation_word")
}

// Registro de quién hace cada cambio en la gestión (panel, moderación).
model AdminAuditLog {
  id        String   @id @default(uuid())
  actorId   String
  action    String
  entity    String
  entityId  String
  data      Json?
  createdAt DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("admin_audit_log")
}

// ---------------------------------------------------------------------------
// Misa en vivo
// ---------------------------------------------------------------------------

model Mass {
  id           String   @id @default(uuid())
  titleEs      String
  titleEn      String
  youtubeUrl   String
  scheduledAt  DateTime
  durationMin  Int      @default(120)
  isSpecial    Boolean  @default(false)
  recordingUrl String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  messages ChatMessage[]

  @@index([scheduledAt])
  @@map("mass")
}

model ChatMessage {
  id        String           @id @default(uuid())
  massId    String
  userId    String
  text      String
  status    ModerationStatus
  createdAt DateTime         @default(now())

  mass Mass @relation(fields: [massId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([massId, status, createdAt])
  @@map("chat_message")
}

// ---------------------------------------------------------------------------
// Causas, votación
// ---------------------------------------------------------------------------

model Cause {
  id            String      @id @default(uuid())
  month         String      // YYYY-MM en que se vota
  nameEs        String
  nameEn        String
  location      String
  responsible   String
  descriptionEs String
  descriptionEn String
  budgetCents   Int
  photos        String[]    @default([])
  timeline      String
  status        CauseStatus @default(candidate)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  votes   Vote[]
  updates CauseUpdate[]
  ledger  LedgerEntry[]

  @@index([month, status])
  @@map("cause")
}

model CauseUpdate {
  id        String   @id @default(uuid())
  causeId   String
  textEs    String
  textEn    String
  photoUrl  String?
  createdAt DateTime @default(now())

  cause Cause @relation(fields: [causeId], references: [id], onDelete: Cascade)

  @@index([causeId, createdAt])
  @@map("cause_update")
}

// Un voto por usuario y mes, garantizado por la base de datos.
model Vote {
  userId    String
  month     String
  causeId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  cause Cause @relation(fields: [causeId], references: [id], onDelete: Restrict)

  @@id([userId, month])
  @@index([causeId])
  @@map("vote")
}
