{
  "name": "@msc/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:seed:catalog": "tsx prisma/seed-catalog.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --coverage",
    "worker": "tsx src/jobs/worker.ts",
    "staff:create": "tsx src/cli/create-staff.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1141.0",
    "@aws-sdk/s3-request-presigner": "3.1141.0",
    "@msc/shared": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@sentry/node": "10.37.0",
    "better-auth": "1.7.6",
    "cors": "2.8.6",
    "expo-server-sdk": "7.2.0",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "jose": "6.2.12",
    "nodemailer": "10.0.12",
    "pg": "8.23.0",
    "pg-boss": "12.34.0",
    "socket.io": "4.8.4",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "9.25.0",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "22.20.4",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.2",
    "eslint": "9.25.0",
    "globals": "17.12.0",
    "prisma": "7.10.0",
    "socket.io-client": "4.8.4",
    "supertest": "7.3.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.2"
  }
}
