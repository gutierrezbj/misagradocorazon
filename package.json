{
  "name": "misagradocorazon",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r --if-present test",
    "mobile": "pnpm --filter @msc/mobile start",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "pnpm": {
    "overrides": {
      "@eslint/plugin-kit": "0.3.4",
      "postcss": "8.5.28",
      "uuid": "11.1.1",
      "undici": "6.29.0",
      "tar": "7.5.19",
      "@eslint/eslintrc>js-yaml": "4.3.2",
      "@expo/xcpretty>js-yaml": "4.3.2",
      "@istanbuljs/load-nyc-config>js-yaml": "3.15.2",
      "shell-quote": "1.9.0",
      "@prisma/config>deepmerge-ts": "8.0.2",
      "prisma>mysql2": "3.24.4",
      "@opentelemetry/instrumentation-http>@opentelemetry/core": "2.11.0"
    }
  },
  "devDependencies": {
    "prettier": "3.8.1"
  }
}
