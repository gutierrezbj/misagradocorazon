# Staging en el VPS: copiar a deploy/staging/.env (nunca al repositorio) y rellenar.
# Qué hace cada variable de la API: .env.example de la raíz.

API_DOMAIN=api-staging.misagradocorazon.com
ADMIN_DOMAIN=admin-staging.misagradocorazon.com
# Beta web instalable (SDD-05 US-27): la abren los fieles.
APP_DOMAIN=app.misagradocorazon.com

# openssl rand -base64 32 (cada una distinta, y distintas de producción).
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
# Si se pierde, las intenciones cifradas de staging son irrecuperables.
INTENTIONS_KEY=

# Beta abierta (SDD-05 US-28): la vela es gratis y no entra nada en el libro de movimientos.
PAYMENTS_MODE=beta_free

# Etiqueta de las imágenes: "staging" (último main) o el SHA de un commit para volver atrás.
IMAGE_TAG=staging

# Opcionales: se descomentan solo las que se usen. Una variable vacía hace que la API no arranque.
#GOOGLE_CLIENT_ID=
APPLE_BUNDLE_ID=com.misagradocorazon.app
#EXPO_ACCESS_TOKEN=
#R2_ACCOUNT_ID=
#R2_ACCESS_KEY_ID=
#R2_SECRET_ACCESS_KEY=
#R2_BUCKET=
#R2_PUBLIC_BASE_URL=
#SMTP_URL=
#MAIL_FROM="Mi Sagrado Corazón <no-reply@misagradocorazon.com>"
#SENTRY_DSN=

# Copias de seguridad diarias fuera del VPS (deploy/staging/README.md, "Copias de seguridad").
# Obligatorias antes de abrir la beta a fieles reales. Bucket de R2 propio, distinto del de medios.
BACKUP_DEST=:s3:msc-backups/staging
# openssl rand -base64 32. Guárdala FUERA del VPS: sin ella las copias no se pueden abrir.
BACKUP_PASSPHRASE=
# R2 → Manage R2 API Tokens: token con permiso de lectura y escritura solo en ese bucket.
BACKUP_S3_ENDPOINT=https://<ID_DE_CUENTA>.r2.cloudflarestorage.com
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
