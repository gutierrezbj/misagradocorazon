# Se copia a /opt/apps/msc/.env en el KVM 1, con permisos 600 (umask 077), y nunca al repositorio.
# Cómo se crea sin imprimir los secretos: deploy/staging/README.md. Qué hace cada variable de la
# API: .env.example de la raíz. Hay cinco variables vacías: los cuatro secretos e IMAGE_TAG.

API_DOMAIN=api-staging.misagradocorazon.com
ADMIN_DOMAIN=admin-staging.misagradocorazon.com
# Beta web instalable (SDD-05 US-27): la abren los fieles.
APP_DOMAIN=app.misagradocorazon.com

# openssl rand -hex 32. En hexadecimal porque en base64 puede salir "/" y romper la DATABASE_URL.
POSTGRES_PASSWORD=
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# openssl rand -base64 32 (32 bytes en base64: apps/api/src/env.ts lo exige).
# Se guarda en el gestor de contraseñas del fundador: la lee él en su terminal y ningún agente la
# imprime ni la copia. Si se pierde, las intenciones cifradas no se pueden recuperar.
INTENTIONS_KEY=

# Obligatoria: compose no arranca sin ella. Beta abierta (SDD-05 US-28): la vela es gratis y no
# entra nada en el libro de movimientos. Sin ella la API usaría "simulated".
PAYMENTS_MODE=beta_free

# Obligatoria: clave con la que se cifran las copias (openssl rand -base64 32).
# Se guarda en el gestor de contraseñas del fundador: la lee él en su terminal y ningún agente la
# imprime ni la copia. Si se pierde, las copias no se pueden abrir.
BACKUP_PASSPHRASE=

# Etiqueta de las imágenes: el SHA completo (40 caracteres, git rev-parse) del commit de main
# cuyo workflow staging-images terminó en verde. Nunca el SHA corto (no existe como etiqueta en
# GHCR y el pull falla) ni "staging" (un pull podría cambiar de versión sin querer).
IMAGE_TAG=

# Opcionales: se descomentan solo las que se usen. Una variable vacía hace que la API no arranque.
#GOOGLE_CLIENT_ID=
APPLE_BUNDLE_ID=com.misagradocorazon.app
#EXPO_ACCESS_TOKEN=
#R2_ACCOUNT_ID=
#R2_ACCESS_KEY_ID=
#R2_SECRET_ACCESS_KEY=
#R2_BUCKET=
#R2_PUBLIC_BASE_URL=
#SMTP_URL=
#MAIL_FROM="Mi Sagrado Corazón <no-reply@misagradocorazon.com>"
#SENTRY_DSN=
