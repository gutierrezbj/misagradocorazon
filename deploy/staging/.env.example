# Staging en el VPS: copiar a deploy/staging/.env (nunca al repositorio) y rellenar.
# Qué hace cada variable de la API: .env.example de la raíz.

API_DOMAIN=api-staging.misagradocorazon.com
ADMIN_DOMAIN=admin-staging.misagradocorazon.com

# openssl rand -base64 32 (cada una distinta, y distintas de producción).
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
# Si se pierde, las intenciones cifradas de staging son irrecuperables.
INTENTIONS_KEY=

# Puertos locales de la API y el panel (solo 127.0.0.1), a los que apunta el proxy del VPS.
# Cambiarlos si ya están ocupados.
API_PORT=18001
ADMIN_PORT=18080

# Etiqueta de las imágenes: "staging" (último main) o el SHA de un commit para volver atrás.
IMAGE_TAG=staging

# Opcionales: se descomentan solo las que se usen. Una variable vacía hace que la API no arranque.
#GOOGLE_CLIENT_ID=
APPLE_BUNDLE_ID=com.misagradocorazon.app
#EXPO_ACCESS_TOKEN=
#R2_ACCOUNT_ID=
#R2_ACCESS_KEY_ID=
#R2_SECRET_ACCESS_KEY=
#R2_BUCKET=
#R2_PUBLIC_BASE_URL=
#SMTP_URL=
#MAIL_FROM="Mi Sagrado Corazón <no-reply@misagradocorazon.com>"
#SENTRY_DSN=
